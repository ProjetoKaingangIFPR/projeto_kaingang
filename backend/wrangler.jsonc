{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projeto-kaingang",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "projeto-kaingang-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projeto-kaingang",
      "database_id": "eacbd4a8-4faf-474c-8114-b2a61a16be1d",
      "migrations_dir": "migrations"
    }
  ]
}
